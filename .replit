modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_BASIC_USER = "ihm-test"
ADMIN_GUARD_TRUST_CF_ACCESS = "0"
DISABLE_DB_PUSH = "1"
DRY_RUN = "1"
ENQUIRY_AUTORUN = "0"
NEXT_PUBLIC_ROBOTS = "noindex"
PAYMENTS_ALLOW_PRODUCTION = "0"
PAYMENTS_DRY_RUN = "1"
PAYMENTS_GATEWAY_MODE = "real"
PORTAL_ENABLED = "0"
RATE_LIMIT_STORE = "memory"
REPLIT_TEST_SITE = "1"
TRACKING_ENABLED = "0"

[userenv.production]
NEXT_PUBLIC_SITE_URL = "https://ihm-website-test-deployment.replit.app"

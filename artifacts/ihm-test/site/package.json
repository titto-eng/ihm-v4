{
  "name": "ihm-web",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int && npm run test:blocks && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "db:fixtures": "node scripts/dev/load-portal-fixtures.mjs",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "import": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import/cli.ts",
    "assets:legacy": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/dev/fetch-legacy-assets.ts",
    "people:photos": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/dev/fetch-people-photos.ts",
    "inventory:wp": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import/wp-db-inventory.ts",
    "import:refresh": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import/refresh-live.ts",
    "extract:samples": "tsx scripts/import/extract-samples.ts",
    "parity": "tsx scripts/parity/crawl.ts",
    "check:blocks": "tsx scripts/check-blocks.ts",
    "test:blocks": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config tests/blocks/vitest.config.mts",
    "test:security": "node --test vendor/deepmerge-safe/test.cjs",
    "check": "npm run test:security && npm run generate:types && npm run typecheck && npm run lint && npm run check:blocks && npm run test:int && npm run test:blocks",
    "status-sheet": "tsx scripts/parity/status-sheet.ts",
    "tracking-sheet": "python3 ../inventory/v2/tracking_sheet.py ihm",
    "test:e2e:alumni": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=tests/alumni/playwright.config.ts",
    "test:e2e:payments": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=tests/e2e/payments/playwright.config.ts",
    "test:e2e:header": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=tests/header/playwright.config.ts",
    "test:e2e:enquiries": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=tests/enquiries/playwright.config.ts",
    "verify:gateways": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/dev/verify-gateways.ts",
    "seed:products": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/dev/seed-products.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@google-cloud/storage": "8.4.0",
    "@hookform/resolvers": "^5.9.2",
    "@next/third-parties": "^16.4.2",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/email-nodemailer": "^3.91.0",
    "@payloadcms/email-resend": "^3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-cloud-storage": "3.91.0",
    "@payloadcms/plugin-seo": "^3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "^3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "csv-parse": "^7.0.3",
    "date-fns": "^4.4.0",
    "deepmerge": "file:vendor/deepmerge-safe",
    "dotenv": "16.4.7",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.8.1",
    "lucide-react": "^1.59.0",
    "mysql2": "^3.24.6",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "p-limit": "^7.3.3",
    "payload": "3.91.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.90.0",
    "sanitize-html": "^2.18.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "4.5.2",
    "acorn": "^8.16.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.5",
    "happy-dom": "^21.0.4",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "happy-dom": "$happy-dom",
    "nodemailer": "$nodemailer",
    "undici": "^7.30.1",
    "fast-uri": "^3.1.9",
    "postcss-selector-parser@6": "^6.1.5",
    "minimatch@10": "^11.0.5",
    "@esbuild-kit/esm-loader": "npm:tsx@^4.23.15"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}

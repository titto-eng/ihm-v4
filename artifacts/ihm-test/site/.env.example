# Replit isolated test copy
REPLIT_TEST_SITE=1
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# Copy to .env and fill in. Never commit .env.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Docker postgres is on 5433 (5432 is often a Homebrew Postgres on macOS; either works)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/ihm
PAYLOAD_SECRET=change-me-32-chars-minimum
# Admin edge guard: basic auth on /admin when both are set (ADMIN_BASIC_HASH = SHA-256 hex of the password).
ADMIN_BASIC_USER=
ADMIN_BASIC_HASH=
# 1 = a request carrying cf-access-authenticated-user-email skips basic auth. Set it only when the origin cannot be reached except through Cloudflare Access.
ADMIN_GUARD_TRUST_CF_ACCESS=0
# Email
EMAIL_FROM=no-reply@ihm.edu.au
RESEND_API_KEY=
# Portal DB (read-only user; PAY_* user may write payments only)
# 0 = the site never waits on the portal DB (dates blocks show the static fallback). Set 1 only with real portal access.
PORTAL_ENABLED=0
# Per-query cap in ms (never above 3000)
PORTAL_QUERY_TIMEOUT_MS=3000
PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=3307
# Dev/tests only: PORTAL_FIXTURE_PORT moves the docker portal-mysql fixture off 3307 (WAMP's MariaDB uses 3307); set PORTAL_DB_PORT to the same value
PORTAL_DB_NAME=ihmedu_portal
PORTAL_DB_RO_USER=
PORTAL_DB_RO_PASSWORD=
PORTAL_DB_PAY_USER=
PORTAL_DB_PAY_PASSWORD=
# Older names still read as aliases: PORTAL_DB_READ_USER, PORTAL_DB_READ_PASSWORD, PORTAL_DB_PAYMENTS_USER, PORTAL_DB_PAYMENTS_PASSWORD (prefer the names above)
# IANA time zone portal dates are rendered in (default Australia/Melbourne)
PORTAL_TZ=
# Integrations. DRY_RUN=1 forces every adapter to record instead of send (the default; email still reaches a local Mailpit).
# To send for real: DRY_RUN=0 AND list the adapter in ENQUIRY_LIVE_ADAPTERS AND set its variables. An adapter that is not listed,
# or lacks a variable, records its request and the delivery row says why (e.g. `missing: HUBSPOT_ACCESS_TOKEN`).
DRY_RUN=1
# Comma list of adapters allowed to send: email, hubspot, portalCrm, portalStakeholder, admissionsApi, dynamics. Empty = none.
ENQUIRY_LIVE_ADAPTERS=
# Payments follow DRY_RUN unless this is set; keep 1 while enquiries go live and payments are not.
PAYMENTS_DRY_RUN=
# portalCrm: URL only, the endpoint takes no credential (inventory/05 §3.1 step 3).
PORTAL_CRM_URL=
# email: RESEND_API_KEY (above) or SMTP_HOST/SMTP_PORT. Without either, mail goes to Mailpit only.
SMTP_HOST=
SMTP_PORT=
# Staff-copy recipients and delivery-dead alerts. The addresses belong in src/content/enquiry-routing.ts (typed by a person; currently
# empty); until they are filled this comma list is the fallback. Never copy addresses from the old code.
ENQUIRY_NOTIFY_TO=
# hubspot: private-app token with crm.objects.contacts.write (+ forms for the Forms API). Portal id is needed when a form GUID is set.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# reCAPTCHA v3: server secret (RECAPTCHA_SECRET is accepted as an alias), minimum score 0-1, public site key
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# portalCrm key (the current endpoint takes none) and the portalStakeholder endpoints
PORTAL_CRM_API_KEY=
PORTAL_IHM_STAKEHOLDER_URL=
PORTAL_IHNA_STAKEHOLDER_URL=
# admissionsApi (Bachelor of Nursing landing pages): both are required.
ADMISSIONS_API_URL=
ADMISSIONS_API_KEY=
DYNAMICS_ENABLED=0
# dynamics (IHNA only): app registration + the Dataverse URL
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_URL=
# Rate-limit store for the public endpoints: memory (default in dev/test) or postgres (default in production)
RATE_LIMIT_STORE=

# Third-party tags (GTM, Clarity, HubSpot, Airgentic) load only when this is 1. Their ids are not env: they are in src/content/site.ts.
TRACKING_ENABLED=0

# Dev-only first admin (seeded by scripts/dev/seed-admin.ts; never used in prod)
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
# Lets import scripts clear the page cache (POST /api/revalidate)
REVALIDATE_SECRET=
# Bearer token for POST /api/payload-jobs/run (runs a queue on demand). Unset locally: the in-process job runner handles the queues.
CRON_SECRET=
# 0 = the in-process job runner stays off (default 1); queues then run only on demand via /api/payload-jobs/run
ENQUIRY_AUTORUN=
# 1 = this process never pushes the dev schema (every script that opens Payload sets it itself, DEC-46)
DISABLE_DB_PUSH=
# 1 = the course route prints `[perf] <label> <ms>` per data step
PERF_TIMING=
# Staging: noindex = robots Disallow: / and a noindex meta on every page
NEXT_PUBLIC_ROBOTS=
# https origin of the student portal auto-enrol iframe (default https://student.ihm.edu.au)
STUDENT_PORTAL_EMBED_ORIGIN=
# ?secret= for /api/preview (Next draft mode); unset = preview is off
PREVIEW_SECRET=
# Script-only: 1 = `npm run import` behaves as --dry; the WordPress site the import reads; the site check-document-links checks
IMPORT_DRY=
LEGACY_BASE_URL=
CHECK_BASE_URL=

# Payments (45-payments). Names only: Allen fills the values in .env (never committed).
# PAYMENTS_GATEWAY_MODE: fake = in-memory FakeGateway (default outside production), real = the gateway clients (default when NODE_ENV=production).
# PAYMENTS_ALLOW_PRODUCTION=1 is REQUIRED before the real clients may reach a production host or a live PayWay merchant; DRY_RUN=1 refuses them always.
#
# SANDBOX (real clients, test accounts, no real money):
#   PAYMENTS_GATEWAY_MODE=real  DRY_RUN=0  PAYMENTS_ALLOW_PRODUCTION=0
#   AIRWALLEX_ENV=demo          -> https://api-demo.airwallex.com (demo client id / API key / webhook secret from the Airwallex sandbox web app)
#   SECUREPAY_ENV=sandbox       -> https://payments-stest.npe.auspost.zone + https://welcome.api2.sandbox.auspost.com.au/oauth/token (test client id/secret/merchant code)
#   PAYWAY_MERCHANT_ID=TEST     -> PayWay has no sandbox host: a free test facility's biller code, Net login, encryption key and merchant TEST
# PRODUCTION:
#   PAYMENTS_GATEWAY_MODE=real  DRY_RUN=0  PAYMENTS_ALLOW_PRODUCTION=1
#   AIRWALLEX_ENV=prod  SECUREPAY_ENV=live  PAYWAY_MERCHANT_ID=<live merchant id>
# The *_URL variables are optional overrides; leave them empty to use the hosts above.
# PayWay also needs this server's egress IP in Setup Net > Security Information (token requests from other IPs are refused),
# and, for the server-to-server notification, PAYWAY_NOTIFY_USERNAME/PASSWORD from Setup Net (the notification URL is
# <site>/api/payments/webhook/payway/). Airwallex webhook URL: <site>/api/payments/webhook/airwallex/.
# Check credentials without creating any payment: VERIFY_GATEWAYS=1 npm run verify:gateways
# (VERIFY_PAYWAY_TOKEN=1 also requests an unused PayWay cart token)
PAYMENTS_GATEWAY_MODE=fake
PAYMENTS_ALLOW_PRODUCTION=0
PAYMENTS_DATA_KEY=
PAYMENTS_MAX_INVOICE_AMOUNT=
PAYMENTS_FINANCE_TO=
# Card surcharge per gateway in percent (empty = none)
PAYMENTS_SURCHARGE_PAYWAY_PERCENT=
PAYMENTS_SURCHARGE_SECUREPAY_PERCENT=
PAYMENTS_SURCHARGE_AIRWALLEX_PERCENT=
PAYWAY_BASE_URL=
PAYWAY_BILLER_CODE=
PAYWAY_MERCHANT_ID=
PAYWAY_USERNAME=
PAYWAY_PASSWORD=
PAYWAY_ENCRYPTION_KEY=
PAYWAY_NOTIFY_USERNAME=
PAYWAY_NOTIFY_PASSWORD=
SECUREPAY_ENV=sandbox
SECUREPAY_AUTH_URL=
SECUREPAY_API_URL=
SECUREPAY_CLIENT_ID=
SECUREPAY_CLIENT_SECRET=
SECUREPAY_MERCHANT_CODE=
SECUREPAY_UI_CLIENT_ID=
# DCC is not supported (the foreign amount would come from the browser); keep 0.
SECUREPAY_DCC=0
AIRWALLEX_API_URL=
AIRWALLEX_ENV=demo
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
PORTAL_IHM_URL=
PORTAL_HCLA_URL=
PORTAL_IHNA_URL=
MONDAY_API_TOKEN=
MONDAY_E2_BOARD_ID=
# monday.com E2 board column ids (text, email, text, status) and the status label to set on a paid item
MONDAY_E2_NAME_COLUMN=
MONDAY_E2_EMAIL_COLUMN=
MONDAY_E2_STUDENT_ID_COLUMN=
MONDAY_E2_STATUS_COLUMN=
MONDAY_E2_STATUS_LABEL=
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_LICENSE_SKU_ID=
CANVAS_URL=
CANVAS_ACCOUNT_ID=
CANVAS_TOKEN=

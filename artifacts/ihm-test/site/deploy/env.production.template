# Production environment for ihm-web (docs/DEPLOYMENT.md §3).
# 1. Copy this file to .env.production in the project folder (it is git-ignored) and fill in every <...>.
# 2. Give the filled file to the hosting team privately (password manager or AWS Secrets Manager), never by email or in Git.
# Every other variable in .env.example may stay unset: the site then keeps the safe defaults (nothing is sent to a CRM,
# no payments, no portal). Turn integrations on later, one at a time, as IHM confirms them.

# --- Site -------------------------------------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://ihm.edu.au
# Staging only: NEXT_PUBLIC_ROBOTS=noindex   (keeps search engines out of a test copy)

# --- Database (the AWS team fills this in: their RDS PostgreSQL 16 endpoint) -----------------------------------------
DATABASE_URL=postgres://<db-user>:<db-password>@<rds-endpoint>:5432/ihm?sslmode=require

# --- Secrets: generate each one with
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=<64 hex characters>
REVALIDATE_SECRET=<64 hex characters>
CRON_SECRET=<64 hex characters>
PREVIEW_SECRET=<64 hex characters>
PAYMENTS_DATA_KEY=<64 hex characters>

# --- Extra password in front of /admin ---------------------------------------------------------------------------------
# ADMIN_BASIC_HASH = SHA-256 of the password:
#     node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "<password>"
ADMIN_BASIC_USER=<admin-gate user name>
ADMIN_BASIC_HASH=<sha256 hex>

# --- Email (choose ONE: Resend API key, or IHM's SMTP server) --------------------------------------------------------
EMAIL_FROM=no-reply@ihm.edu.au
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=

# --- Behaviour ----------------------------------------------------------------------------------------------------------
RATE_LIMIT_STORE=postgres
# 1 = GTM, Clarity, HubSpot tags load (production only)
TRACKING_ENABLED=1
# Safe start: forms are saved in the CMS but not sent to CRMs; no real payments; portal dates off.
DRY_RUN=1
ENQUIRY_LIVE_ADAPTERS=
PAYMENTS_GATEWAY_MODE=fake
PAYMENTS_ALLOW_PRODUCTION=0
PORTAL_ENABLED=0
# reCAPTCHA v3 for the forms (recommended before go-live)
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
